  "profile": {
    "specVersion": 1,
    "docsDir": "docs",
    "managedBlocks": [
      {
        "id": "gitattributes-block",
        "path": ".gitattributes",
        "body": "# Normalise to LF so generated/hashed files (e.g. topology/family.md, the CLI's byte-pins)\n# match on every platform — atlas's `--check` freshness gates depend on it. This is the\n# error-floor rule `atlas process check` requires of every member's .gitattributes.\n* text=auto eol=lf\n# PowerShell stays CRLF for native Windows execution.\n*.ps1 text eol=crlf\n"
      },
      {
        "id": "gitignore-block",
        "path": ".gitignore",
        "body": "# Dependencies + build noise.\nnode_modules/\n*.log\n.DS_Store\n# Worktrees (the canonical dev workflow) + per-agent local state.\n.worktrees/\n.claude/worktrees\n.claude/settings.local.json\n"
      }
    ],
    "owned": [
      {
        "id": "security-policy",
        "path": "SECURITY.md",
        "contract": "present, and it names a private reporting channel (GitHub private vulnerability reporting or a security address) — never 'open an issue'"
      },
      {
        "id": "issue-chooser",
        "path": ".github/ISSUE_TEMPLATE/config.yml",
        "contract": ".github/ISSUE_TEMPLATE/config.yml is present"
      },
      {
        "id": "pr-template",
        "path": ".github/PULL_REQUEST_TEMPLATE.md",
        "contract": ".github/PULL_REQUEST_TEMPLATE.md is present"
      },
      {
        "id": "agent-docs",
        "path": "AGENTS.md",
        "contract": "present; the content is the member's own, reviewed before publication"
      },
      {
        "id": "agent-docs",
        "path": "CLAUDE.md",
        "contract": "present; the content is the member's own, reviewed before publication"
      },
      {
